# Configuração da suíte de testes de regressão.
#
# ATENÇÃO: os testes CRIAM E APAGAM listas, itens e associações.
# Aponte para um projeto Supabase dedicado a testes — nunca o de produção.
# As variáveis têm nomes próprios (TEST_*) e não herdam nada do
# .env.local justamente para que apontar o alvo seja uma decisão consciente.

TEST_SUPABASE_URL=https://SEU-PROJETO-DE-TESTE.supabase.co
TEST_SUPABASE_ANON_KEY=sua-chave-anon-de-teste

# Três contas criadas em Authentication > Users, com "Auto Confirm User"
# marcado. Podem ter a mesma senha; os endereços é que precisam diferir.
TEST_USER_A_EMAIL=teste-a@exemplo.com
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=teste-b@exemplo.com
TEST_USER_B_PASSWORD=
TEST_USER_C_EMAIL=teste-c@exemplo.com
TEST_USER_C_PASSWORD=
